# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare Unity text assets and C# scripts as LF
*.cs text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.scenetemplate text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.shadergraph text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.ttf binary
*.TTF binary
*.otf binary
*.wav binary
*.mp3 binary
*.ogg binary
*.zip binary
*.dll binary
*.exe binary

# Exclude third-party TextMesh Pro and Unity shaders from GitHub language statistics
"Assets/TextMesh Pro/**" linguist-vendored
*.shader linguist-detectable=false
*.hlsl linguist-detectable=false
*.cginc linguist-detectable=false
*.shadergraph linguist-detectable=false
